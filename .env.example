# Never commit real credentials. Copy this file to .env locally.
SERVER_PORT=8080

# SerpApi — server-side only
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT_SECONDS=8
SERPAPI_MAX_RESULTS=8

# You.com Research API — server-side only
YOU_API_KEY=
YOU_API_BASE_URL=https://api.you.com/v1/research
YOU_API_TIMEOUT_SECONDS=60
YOU_RESEARCH_EFFORT=lite

# Nexconn Chat SDK
# App Key and user access token are returned at runtime by the backend.
# App Secret must never be exposed to the browser.
NEXCONN_APP_KEY=
NEXCONN_USER_TOKEN=
NEXCONN_USER_ID=
NEXCONN_GROUP_ID=

# Optional infrastructure reserved for future extensions
DB_URL=jdbc:postgresql://localhost:5432/telyvo
DB_USERNAME=telyvo
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
