# Never put real credentials in this file.
# Copy to .env locally and populate values there.

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# SerpApi — server-side only
SERPAPI_KEY=

# You.com — use the exact key and API configuration issued in your You.com developer account
YOU_API_KEY=
YOU_API_BASE_URL=

# Nexconn — use the credentials and configuration supplied by the SDK/dashboard
NEXCONN_APP_ID=
NEXCONN_API_KEY=
NEXCONN_API_SECRET=
NEXCONN_BASE_URL=

# Optional persistence
DB_URL=jdbc:postgresql://localhost:5432/telyvo
DB_USERNAME=telyvo
DB_PASSWORD=

# Optional cache
REDIS_HOST=localhost
REDIS_PORT=6379
