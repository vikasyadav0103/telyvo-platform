# Never put real credentials in this file. Copy to .env locally.
SERVER_PORT=8080

# SerpApi — server-side only
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_TIMEOUT_SECONDS=8
SERPAPI_MAX_RESULTS=8

# You.com — configure only after confirming the exact product/API contract
YOU_API_KEY=
YOU_API_BASE_URL=

# Nexconn — privileged credentials remain server-side
NEXCONN_APP_ID=
NEXCONN_API_KEY=
NEXCONN_API_SECRET=
NEXCONN_BASE_URL=

# Optional persistence/cache infrastructure (not required for current MVP)
DB_URL=jdbc:postgresql://localhost:5432/telyvo
DB_USERNAME=telyvo
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
